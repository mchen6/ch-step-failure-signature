{
  "name": "@countinghouse/ch-step-failure-signature",
  "version": "0.1.0",
  "description": "countinghouse step module: a stable fingerprint for a CI failure: the failing step and its error lines, with numbers, paths, times and hashes generalised away.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mchen6/ch-step-failure-signature.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "api.json",
    "schema.json",
    "handlers/",
    "lib/"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "validate": "node scripts/validate.js"
  },
  "countinghouse": {
    "role": "part"
  },
  "devDependencies": {
    "countinghouse": "git+https://github.com/mchen6/countinghouse.git#9e1cdb591f470ea502f060ed70ce244bdab633fe"
  },
  "allowScripts": {
    "dtrace-provider": false,
    "msgpackr-extract": false,
    "sqlite3": false
  }
}
